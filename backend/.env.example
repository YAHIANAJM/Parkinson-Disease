# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
FRONTEND_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # service_role key (never expose to frontend)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...    # anon key (safe for frontend)

# ── Python ML ─────────────────────────────────────────────────────────────────
PYTHON_PATH=python
MODEL_SCRIPT=../predict.py
TRAIN_SCRIPT=../train.py

# ── Doctor (dev only — skip auth during development) ─────────────────────────
# Replace with your actual Supabase doctor UUID after first login
DEV_DOCTOR_ID=00000000-0000-0000-0000-000000000000
